<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox id="VBox" alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="xal.extension.fxapplication.LogbookProviderSelectionController">
   <children>
      <Label text="Select a logbook provider:" />
      <ChoiceBox fx:id="logbookProvidersCB" prefWidth="150.0" />
      <Button fx:id="okB" mnemonicParsing="false" onAction="#okBAction" text="Ok" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
